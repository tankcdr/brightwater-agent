{
  "realm": "brightwater",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      {
        "name": "banker",
        "description": "Assesses applications for businesses they cover"
      },
      {
        "name": "procedure_author",
        "description": "May publish procedures and governance queries"
      }
    ]
  },
  "clients": [
    {
      "clientId": "brightwater-cli",
      "name": "brightwater CLI and agent",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": [],
      "protocolMappers": [
        {
          "name": "gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "brightwater-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
