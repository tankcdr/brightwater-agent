<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ch 10: run one retrain-evaluate-promote cycle every Sunday at 02:30.
  Edit REPO_PATH, then:
    cp ops/launchd/com.longrunadvisory.brightwater.dm-cycle.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.longrunadvisory.brightwater.dm-cycle.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.longrunadvisory.brightwater.dm-cycle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd REPO_PATH &amp;&amp; source .venv/bin/activate &amp;&amp; brightwater dm cycle &gt;&gt; results/dm-cycle.log 2&gt;&amp;1</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardErrorPath</key><string>/tmp/brightwater-dm-cycle.err</string>
</dict>
</plist>
